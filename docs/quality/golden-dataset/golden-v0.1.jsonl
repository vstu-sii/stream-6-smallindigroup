{"id":"gd-0002","version":"0.1","source":{"kind":"synthetic","basis":"pain:material"},"input":{"platform":"ozon","category":"худи","rating":2,"text":"После первой же стирки на 30 градусах пошли катышки по всему животу. Выглядит как поношенная за год."},"expected":{"sentiment":"negative","problems":[{"code":"material_quality","evidence":"После первой же стирки ... пошли катышки"}],"severity":"high","owner":"seller","suspicious":false,"has_instruction":false,"reply":{"must":["признать проблему","предложить возврат или обмен по правилам площадки"],"must_not":["советовать стирать иначе как оправдание"]}},"tags":["single_problem","grouping_pair:material_after_wash"]}
